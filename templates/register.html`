<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NIMBUS | Register</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <style>
        .member-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin-bottom: 1rem;
            padding: 1rem;
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
            border: 1px solid #333;
            position: relative;
        }
        .member-row input {
            padding: 0.6rem;
        }
        .section-title {
            color: var(--accent);
            margin: 1.5rem 0 1rem 0;
            border-bottom: 1px solid #333;
            padding-bottom: 0.5rem;
        }
        .remove-btn {
            position: absolute;
            right: -30px;
            top: 10px;
            background: var(--error);
            color: white;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            cursor: pointer;
            font-size: 12px;
            line-height: 1;
        }
        .radio-group {
            display: flex;
            gap: 15px;
            align-items: center;
            margin: 10px 0;
            color: var(--text-main);
        }
        .radio-group label {
            display: inline;
            margin: 0;
            cursor: pointer;
            font-weight: normal;
        }
    </style>
</head>
<body>
    <header>
        <h1>NIMBUS</h1>
        <p>Join the Storm</p>
    </header>

    <div class="container">
        <div class="card" style="max-width: 800px; margin: 0 auto;">
            <h2 style="text-align: center;">Team Registration</h2>
            <p style="text-align: center; color: var(--text-dim); margin-bottom: 2rem;">
                Minimum 2 members, Maximum 4 members per team.
            </p>
            <form action="/register" method="POST" id="regForm">

                <div class="form-group">
                    <label>Team Name</label>
                    <input type="text" name="team_name" required placeholder="Enter a cool team name">
                </div>

                <div class="section-title">Leader Details</div>
                <div class="grid" style="grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="leader_name" required placeholder="John Doe">
                    </div>
                    <div class="form-group">
                        <label>College Email</label>
                        <input type="email" name="leader_email" required placeholder="leader@college.edu">
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="text" name="leader_phone" required placeholder="+91 0000000000">
                    </div>
                </div>

                <div class="form-group">
                    <label>Residency Status</label>
                    <div class="radio-group">
                        <input type="radio" id="leader_day" name="leader_status" value="Day Scholar" required>
                        <label for="leader_day">Day Scholar</label>
                        <input type="radio" id="leader_host" name="leader_status" value="Hosteller">
                        <label for="leader_host">Hosteller</label>
                    </div>
                </div>

                <div class="section-title">Team Members</div>
                <div id="members-container">
                    <!-- Member rows will be added here by JS -->
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                    <button type="button" id="add-member" class="btn" style="background: #333;">+ Add Member</button>
                    <span id="member-count" style="color: var(--text-dim);">Members: 1/4 (including leader)</span>
                </div>

                <button type="submit" class="btn" style="width: 100%; padding: 1rem; font-size: 1.2rem;">Register Team & Proceed to Payment</button>
            </form>
        </div>
    </div>

    <script>
        const container = document.getElementById('members-container');
        const addBtn = document.getElementById('add-member');
        const countDisplay = document.getElementById('member-count');

        let memberCount = 1;

        function updateCount() {
            countDisplay.innerText = `Members: ${memberCount}/4 (including leader)`;
            if (memberCount >= 4) {
                addBtn.disabled = true;
                addBtn.style.opacity = '0.5';
                addBtn.style.cursor = 'not-allowed';
            } else {
                addBtn.disabled = false;
                addBtn.style.opacity = '1';
                addBtn.style.cursor = 'pointer';
            }
        }

        function createMemberRow(index) {
            const div = document.createElement('div');
            div.className = 'member-row';
            div.style.gridTemplateColumns = '1fr 1fr 1fr'; // Maintain 3 col layout
            div.innerHTML = `
                <div style="display:flex; flex-direction:column; gap:5px;">
                    <input type="text" name="member_name" placeholder="Full Name" required>
                </div>
                <div style="display:flex; flex-direction:column; gap:5px;">
                    <input type="email" name="member_email" placeholder="college@email.edu" required>
                </div>
                <div style="display:flex; flex-direction:column; gap:5px;">
                    <input type="text" name="member_phone" placeholder="Phone Number" required>
                </div>
                <button type="button" class="remove-btn" onclick="removeMember(this)">×</button>
            `;

            // We need a separate row for the residency status for each member to avoid name conflicts
            const statusDiv = document.createElement('div');
            statusDiv.className = 'radio-group';
            statusDiv.style.gridColumn = 'span 3';
            statusDiv.style.marginBottom = '15px';
            statusDiv.innerHTML = `
                <span style="font-size:0.8rem; color:var(--text-dim); margin-right:10px;">Residency:</span>
                <input type="radio" name="member_status_${index}" value="Day Scholar" required>
                <label>Day Scholar</label>
                <input type="radio" name="member_status_${index}" value="Hosteller">
                <label>Hosteller</label>
            `;

            // Wrap both in a container to keep them together
            const wrapper = document.createElement('div');
            wrapper.style.marginBottom = '1.5rem';
            wrapper.style.padding = '1rem';
            wrapper.style.background = 'rgba(255,255,255,0.05)';
            wrapper.style.borderRadius = '8px';
            wrapper.style.border = '1px solid #333';
            wrapper.style.position = 'relative';

            const row = document.createElement('div');
            row.style.display = 'grid';
            row.style.gridTemplateColumns = '1fr 1fr 1fr';
            row.style.gap = '10px';
            row.innerHTML = `
                <input type="text" name="member_name" placeholder="Full Name" required>
                <input type="email" name="member_email" placeholder="college@email.edu" required>
                <input type="text" name="member_phone" placeholder="Phone Number" required>
            `;

            const removeBtn = document.createElement('button');
            removeBtn.className = 'remove-btn';
            removeBtn.innerHTML = '×';
            removeBtn.onclick = function() {
                wrapper.remove();
                memberCount--;
                updateCount();
            };

            wrapper.appendChild(row);
            wrapper.appendChild(statusDiv);
            wrapper.appendChild(removeBtn);

            return wrapper;
        }

        addBtn.onclick = function() {
            if (memberCount < 4) {
                container.appendChild(createMemberRow(memberCount));
                memberCount++;
                updateCount();
            }
        };

        window.onload = function() {
            container.appendChild(createMemberRow(1));
            memberCount++;
            updateCount();
        };

        document.getElementById('regForm').onsubmit = function(e) {
            if (memberCount < 2) {
                alert('You must have at least 2 members in a team (including the leader).');
                e.preventDefault();
                return false;
            }
        };
    </script>
</body>
</html>
